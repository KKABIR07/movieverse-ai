# MovieVerse AI (mkmovies) — environment template. Copy to .env and fill in. NEVER commit real values.
# On the OCI box, scripts/deploy.sh creates /opt/mkmovies/.env from this file on the first run
# (with a freshly generated JWT_SECRET) and scripts/push-env.sh fills in the secrets.

# --- Runtime ---
# Host port the container binds on 127.0.0.1 (Caddy proxies www.mkmovies.site to it).
APP_PORT=3120
NODE_ENV=production

# --- Public site URL ---
# Inlined into the client bundle at BUILD time (passed as a Docker build arg). Canonical host is www.
NEXT_PUBLIC_SITE_URL=https://www.mkmovies.site
# Server-side canonical URL (metadata, sitemap, absolute links).
SITE_URL=https://www.mkmovies.site

# --- TMDB (required) ---
# v4 API Read Access Token ("Bearer" token) from https://www.themoviedb.org/settings/api
TMDB_BEARER=
# Optional v3 API key (fallback for endpoints that use ?api_key=).
TMDB_API_KEY=

# --- MongoDB Atlas (required) ---
# mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# The Atlas cluster must be running and its IP access list must allow 163.192.105.150.
MONGODB_URI=

# --- Auth (required) ---
# Random secret, at least 32 characters. deploy.sh generates one on first deploy (openssl rand -hex 48).
JWT_SECRET=

# --- AI chat (required) ---
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# --- YouTube (required) ---
# YouTube Data API v3 key (trailers / shorts).
YOUTUBE_API_KEY=
