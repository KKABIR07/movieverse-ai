# MovieVerse AI (mkmovies) — environment template. Copy to .env and fill in. NEVER commit real values.
# On the OCI box, scripts/deploy.sh creates /opt/mkmovies/.env from this file on the first run
# (with freshly generated JWT_SECRET, POSTGRES_PASSWORD and DATABASE_URL) and scripts/push-env.sh
# fills in the external API keys.

# --- Runtime ---
# Host port the web container binds on 127.0.0.1 (Caddy proxies www.mkmovies.site to it).
APP_PORT=3120
NODE_ENV=production

# --- Public site URL ---
# Inlined into the client bundle at BUILD time (passed as a Docker build arg). Canonical host is www.
NEXT_PUBLIC_SITE_URL=https://www.mkmovies.site
# Server-side canonical URL (metadata, sitemap, absolute links).
SITE_URL=https://www.mkmovies.site

# --- TMDB (required) ---
# v4 API Read Access Token ("Bearer" token) from https://www.themoviedb.org/settings/api
TMDB_BEARER=
# Optional v3 API key (fallback for endpoints that use ?api_key=).
TMDB_API_KEY=

# --- PostgreSQL (local container `db`; required, generated on first deploy) ---
# The database runs next to the app (compose service `db`, internal network only, no host port).
# deploy.sh generates POSTGRES_PASSWORD (openssl rand -hex 24) and builds DATABASE_URL from it.
# Do NOT change POSTGRES_PASSWORD after the first start: Postgres stores it in pgdata at initdb time.
POSTGRES_USER=mkmovies
POSTGRES_DB=mkmovies
POSTGRES_PASSWORD=
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=

# --- Auth (required) ---
# Random secret, at least 32 characters. deploy.sh generates one on first deploy (openssl rand -hex 48).
JWT_SECRET=

# --- AI chat (optional — the chat feature is disabled without it) ---
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b
GROQ_MODEL=

# --- YouTube (optional — trailers/shorts degrade without it) ---
# YouTube Data API v3 key.
YOUTUBE_API_KEY=

# --- Host integration (set by deploy.sh; leave empty) ---
# cgroup parent for both containers. Empty = "mkmovies.slice" (Docker systemd cgroup driver).
# deploy.sh sets "/mkmovies.slice" if the box's Docker uses the cgroupfs driver.
MKMOVIES_CGROUP_PARENT=
